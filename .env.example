# ── 로컬 데모 (apps/api) ──
# 아래 비밀키는 비워두면 소스의 더미 기본값을 쓴다. 로컬 회로 실행에는
# 실제 자산이 없으므로 무해하다.
PORT=3011
LTV_BPS=8000                # 담보 한도 80%
ISSUER_ID=0x1111111111111111111111111111111111111111111111111111111111111111
ISSUER_SECRET_KEY=
SUPPLIER_SECRET_KEY=
WEB_ORIGIN=http://localhost:3000,http://localhost:3040

# ── 프론트 (apps/web) ──
NEXT_PUBLIC_API_URL=http://localhost:3011

# ── 테스트넷 배포 (apps/deploy) ──
# 여기서부터는 기본값이 없다. 비워두면 배포가 중단된다.
# 공개 저장소에 적힌 더미키로 배포하면 누구나 발급 기관 권한 회로를
# 호출할 수 있어 A8 주장이 무너진다.
#
#   openssl rand -hex 32   로 만들고 앞에 0x를 붙인다
#   ISSUER_SECRET_KEY=0x...
#   SUPPLIER_SECRET_KEY=0x...
#
# 지갑 시드. pnpm --filter @once/deploy address 로 생성한다.
DEPLOY_WALLET_SEED=
PROOF_SERVER_URL=http://127.0.0.1:6300
