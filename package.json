{
  "name": "once-finance",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build:contract": "pnpm --filter @once/contract build",
    "test": "vitest run",
    "test:attacks": "vitest run test/attacks",
    "typecheck": "tsc --noEmit -p packages/domain/tsconfig.json && tsc --noEmit -p packages/crypto/tsconfig.json && tsc --noEmit -p packages/chain/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/deploy/tsconfig.json && pnpm --filter @once/web exec tsc --noEmit",
    "lint": "eslint .",
    "dev": "pnpm --parallel --filter @once/api --filter @once/web dev",
    "dev:api": "pnpm --filter @once/api dev",
    "dev:web": "pnpm --filter @once/web dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@types/node": "^22.13.1",
    "typescript-eslint": "^8.23.0",
    "eslint": "^9.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "classic-level",
      "msgpackr-extract"
    ],
    "overrides": {
      "@midnight-ntwrk/ledger-v8": "8.1.2"
    }
  }
}
