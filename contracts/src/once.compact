pragma language_version 0.26;

import CompactStandardLibrary;

// ONCE Finance — 매출채권 중복담보 방지 컨트랙트
//
// 불변식 (docs/SPEC.md §1.1)
//   INV-1  nullifier  = H(TAG_NULLIFIER, issuerId, invoiceId)   ← salt 무관
//   INV-2  commitment = H(TAG_COMMITMENT, invoiceId, faceAmount, ownerPk, salt)
//   INV-3  nullifier 미사용 검사와 자금 지급이 같은 트랜잭션에서 일어난다

export struct LoanRecord {
  lender: Bytes<32>;
  amount: Uint<64>;
  commitment: Bytes<32>;
}

// 납품업체가 비공개로 보유하는 채권 원문. 원장에 닿지 않는다.
export struct PrivateInvoice {
  invoiceId: Bytes<32>;
  faceAmount: Uint<64>;
  salt: Bytes<32>;
}

// ── 공개 원장 ────────────────────────────────────────────────
// 여기에 채권 원문 필드는 존재하지 않는다 (CONTEXT §4.1)

export ledger issuerId: Bytes<32>;            // 발급 기관 식별자. 불변 (INV-1 입력)
export ledger issuerPk: Bytes<32>;            // 발급 기관 공개키. 채권 등록 권한
export ledger ltvBps: Uint<64>;               // 담보 한도 (basis point)
export ledger fundingColor: Bytes<32>;        // 데모 자금 토큰 색

export ledger invoiceTree: HistoricMerkleTree<10, Bytes<32>>;  // 유효 채권 리프
export ledger usedNullifiers: Set<Bytes<32>>;                  // 사용된 중복 확인값
export ledger loans: Map<Bytes<32>, LoanRecord>;               // nullifier → 대출 기록
export ledger registeredLenders: Set<Bytes<32>>;               // 등록된 금융사
export ledger lenderVault: Map<Bytes<32>, Uint<64>>;           // 금융사별 예치 잔액

// ── 비공개 입력 ──────────────────────────────────────────────
witness privateInvoice(): PrivateInvoice;
witness ownerSecret(): Bytes<32>;
witness invoicePath(): MerkleTreePath<10, Bytes<32>>;
witness issuerSecret(): Bytes<32>;

constructor(issuerId_: Bytes<32>, issuerPk_: Bytes<32>, ltvBps_: Uint<64>) {
  issuerId = disclose(issuerId_);
  issuerPk = disclose(issuerPk_);
  ltvBps = disclose(ltvBps_);
}

// ── 순수 해시 회로 (packages/crypto의 TS 구현과 1:1 대응) ──────

export circuit ownerPublicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "ONCE/owner-pk"), sk]);
}

export circuit issuerPublicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "ONCE/issuer-pk"), sk]);
}

// 발급자 Merkle 리프. salt를 포함하지 않는다.
export circuit invoiceLeaf(invoiceId: Bytes<32>, faceAmount: Uint<64>, ownerPk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "ONCE/leaf"),
    invoiceId,
    faceAmount as Field as Bytes<32>,
    ownerPk
  ]);
}

// INV-1: salt·금융사·시각·신청자에 의존하지 않는다.
export circuit nullifierOf(issuerId_: Bytes<32>, invoiceId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "ONCE/nf"),
    issuerId_,
    invoiceId
  ]);
}

// INV-2: salt를 포함한다.
export circuit commitmentOf(
  invoiceId: Bytes<32>,
  faceAmount: Uint<64>,
  ownerPk: Bytes<32>,
  salt: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "ONCE/cm"),
    invoiceId,
    faceAmount as Field as Bytes<32>,
    ownerPk,
    salt
  ]);
}

// ── 운영 회로 ────────────────────────────────────────────────

// 발급 기관이 유효 채권 리프를 등록한다. 리프는 해시이므로 원문을 드러내지 않는다.
export circuit registerInvoice(leaf: Bytes<32>): [] {
  assert(issuerPublicKey(issuerSecret()) == issuerPk, "issuer authorization failed");
  invoiceTree.insert(disclose(leaf));
}

export circuit registerLender(lender: Bytes<32>): [] {
  assert(issuerPublicKey(issuerSecret()) == issuerPk, "issuer authorization failed");
  registeredLenders.insert(disclose(lender));
}

// 데모용 자금 예치. 금융사 잔액을 늘리고 컨트랙트가 토큰을 보유한다.
export circuit fundLender(lender: Bytes<32>, amount: Uint<64>): [] {
  assert(issuerPublicKey(issuerSecret()) == issuerPk, "issuer authorization failed");
  assert(registeredLenders.member(disclose(lender)), "lender not registered");
  const color = mintUnshieldedToken(
    pad(32, "ONCE/funding"),
    disclose(amount),
    left<ContractAddress, UserAddress>(kernel.self())
  );
  fundingColor = color;
  const prev = lenderVault.member(disclose(lender)) ? lenderVault.lookup(disclose(lender)) : 0 as Uint<64>;
  lenderVault.insert(disclose(lender), (prev + disclose(amount)) as Uint<64>);
}

// ── 핵심 회로: 중복 확인값 등록과 자금 지급이 한 트랜잭션 (INV-3) ──
export circuit finance(
  lender: Bytes<32>,
  amount: Uint<64>,
  recipient: UserAddress
): [] {
  const inv = privateInvoice();
  const sk = ownerSecret();
  const path = invoicePath();

  // 1. 신청자가 소유자인가
  const ownerPk = ownerPublicKey(sk);

  // 2. 발급 기관이 인증한 채권인가
  const leaf = invoiceLeaf(inv.invoiceId, inv.faceAmount, ownerPk);
  assert(path.leaf == leaf, "invoice leaf mismatch");
  assert(invoiceTree.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))), "invoice not attested by issuer");

  // 3. 요청 금액이 담보 한도 이내인가 (정수 연산만)
  assert(amount * 10000 <= inv.faceAmount * ltvBps, "amount exceeds LTV");

  // 4. 중복 확인값 (INV-1) — salt에 의존하지 않는다
  const nf = nullifierOf(issuerId, inv.invoiceId);

  // 5. 봉인값 (INV-2) — salt를 포함한다
  const cm = commitmentOf(inv.invoiceId, inv.faceAmount, ownerPk, inv.salt);

  // ── 공개 상태 변경: 실행 시점에 재확인한다 (INV-3) ──
  assert(registeredLenders.member(disclose(lender)), "lender not registered");
  assert(!usedNullifiers.member(disclose(nf)), "nullifier already used");
  assert(lenderVault.member(disclose(lender)), "lender has no funding");
  const balance = lenderVault.lookup(disclose(lender));
  assert(balance >= amount, "insufficient lender funding");

  usedNullifiers.insert(disclose(nf));
  loans.insert(disclose(nf), LoanRecord {
    lender: disclose(lender),
    amount: disclose(amount),
    commitment: disclose(cm)
  });
  lenderVault.insert(disclose(lender), (balance - disclose(amount)) as Uint<64>);

  // 같은 트랜잭션에서 자금이 나간다
  sendUnshielded(fundingColor, disclose(amount) as Uint<128>, right<ContractAddress, UserAddress>(disclose(recipient)));
}
